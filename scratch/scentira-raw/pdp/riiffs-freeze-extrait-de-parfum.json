{"product":{"id":7830301966414,"title":"Riiffs Freeze Extrait De Parfum","body_html":"\u003cp\u003e\u003cu\u003e\u003cb\u003eRiiffs Freeze Extrait De Parfum\u003c\/b\u003e\u003c\/u\u003e is a fresh, cool and slightly citrusy fragrance, launched in \u003cb\u003e2025\u003c\/b\u003e. It opens with a blast of lemon zest, bergamot and grapefruit mixed with mint, giving a very icy and refreshing feel. There is also a unique “snow” accord which makes it feel extra cold and clean. In the middle, ginger and tea add a light spicy and aromatic touch. In the dry down, amber, cedar and peony give a smooth, soft and slightly woody base.\u003c\/p\u003e","vendor":"Riiffs","product_type":"","created_at":"2026-02-17T15:47:13+05:30","handle":"riiffs-freeze-extrait-de-parfum","updated_at":"2026-09-23T18:54:33+05:30","published_at":"2026-02-17T15:47:13+05:30","template_suffix":null,"published_scope":"web","tags":"mens, occasion-daily, occasion-date-night, occasion-gym, occasion-office, occasion-wedding, scent-amber, scent-aromatic-spicy, scent-floral, scent-fresh-citrus, scent-fruity, season-autumn, season-monsoon, season-summer, season-winter, under-6000, womens","variants":[{"id":43451134607438,"product_id":7830301966414,"title":"Retail Bottle (100 mL)","price":"4859.00","sku":"RII-FRE-EXD-100","position":1,"compare_at_price":"5399.00","fulfillment_service":"manual","inventory_management":"shopify","option1":"Retail Bottle (100 mL)","option2":null,"option3":null,"created_at":"2026-02-17T15:47:13+05:30","updated_at":"2026-09-23T18:54:33+05:30","taxable":true,"barcode":null,"grams":0,"image_id":46018434334798,"weight":0.0,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"INR","compare_at_price_currency":"INR","quantity_price_breaks":[]},{"id":43451134640206,"product_id":7830301966414,"title":"5mL Decant","price":"355.00","sku":"RII-FRE-EXD-5D","position":2,"compare_at_price":"","fulfillment_service":"manual","inventory_manag